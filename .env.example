# Backend origin or API base; Next.js proxies requests and stores tokens in HttpOnly cookies.
BACKEND_API_URL=https://pharmecy.genify.live/api/v1
NODE_ENV=production
PORT=3000

# Staging-only membership/access preview. Backend tenant-session router must be
# explicitly mounted with a reviewed auth-bootstrap connection. Keep false live.
TENANT_SESSION_PREVIEW_ENABLED=false
# Separate, reviewed tenant API base (must include its /api/v1 mount).
# No fallback to BACKEND_API_URL; keep both preview flags false live.
TENANT_WORKSPACE_PREVIEW_ENABLED=false
# New tenant preview mutations only; legacy writes are unaffected.
TENANT_CATALOG_WRITES_ENABLED=false
TENANT_BACKEND_API_URL=
